# Production template for the live school server.
# Copy to .env on the server, fill in every <...> value, then run:
#   php artisan key:generate && php artisan migrate --force && php artisan optimize
# Then add this cron job, or the daily 01:00 database backup and the cleanup of old logs/announcements never run:
#   * * * * * cd /path/to/elearning && php artisan schedule:run >> /dev/null 2>&1
# Never commit the filled-in copy.

APP_NAME="E-Learning SMK Bhakti Insani"
APP_ENV=production
APP_KEY=
# Must stay false: true shows stack traces and configuration on every error page.
APP_DEBUG=false
# The public https address; links, redirects and trusted hosts are built from it.
APP_URL=https://<domain-sekolah>

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# Use a dedicated MySQL user with rights on this database only, never root.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=db_learning_smk
DB_USERNAME=<elearning_app>
DB_PASSWORD=<strong-random-password>

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# The session cookie is only sent over https.
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
QUEUE_FAILED_DRIVER=null

CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@<domain-sekolah>"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
